# Example environment variables for the Concrecol project
# Copy this to .env.local and fill in your actual values
# NEVER commit .env files to version control!

# Database - Use Supabase Connection Pooler for production
# Get this from: Supabase Dashboard > Settings > Database > Connection parameters
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres"

# NextAuth - Generate a secure secret
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secure-secret-minimum-32-characters"
NEXTAUTH_URL="http://localhost:3000"

# Admin default credentials - CHANGE THESE IN PRODUCTION!
ADMIN_DEFAULT_EMAIL="admin@concrecol.com"
ADMIN_DEFAULT_PASSWORD="change-this-secure-password"

# Environment
NODE_ENV="development"

# Optional: Stripe for payments
# STRIPE_PUBLIC_KEY="pk_test_..."
# STRIPE_SECRET_KEY="sk_test_..."

# Optional: Siigo API for invoicing  
# SIIGO_USERNAME="your-siigo-username"
# SIIGO_ACCESS_KEY="your-siigo-access-key"

# Optional: Email configuration
# EMAIL_SERVER_HOST="smtp.gmail.com"
# EMAIL_SERVER_PORT="587"
# EMAIL_SERVER_USER="your-email@gmail.com"
# EMAIL_SERVER_PASSWORD="your-app-password"
# EMAIL_FROM="noreply@concrecol.com"
