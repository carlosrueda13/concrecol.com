# NextAuth (admin)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-key
ADMIN_DEFAULT_EMAIL=admin@concrecol.com
ADMIN_DEFAULT_PASSWORD=your-secure-password

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/concrecol?schema=public"

# Stripe
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
STRIPE_CURRENCY=COP
STRIPE_COUNTRY=CO

# SIIGO
SIIGO_CLIENT_ID=your-siigo-client-id
SIIGO_CLIENT_SECRET=your-siigo-client-secret
SIIGO_USERNAME=your-siigo-username
SIIGO_PASSWORD=your-siigo-password
SIIGO_ENV=sandbox

# WhatsApp Business API
WABA_PHONE_NUMBER_ID=your-waba-phone-id
WABA_BUSINESS_ACCOUNT_ID=your-waba-business-account-id
WABA_ACCESS_TOKEN=your-waba-access-token
WABA_SALES_NUMBER_E164=+573001234567  # Example, replace with actual sales number

# Email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
EMAIL_FROM="Concrecol <no-reply@concrecol.com>"

# Upstash Redis (rate limit)
UPSTASH_REDIS_REST_URL=your-upstash-redis-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token
