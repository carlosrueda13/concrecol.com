# Example environment variables for the Concrecol project
# Copy this file to .env and fill in your real values.
# NEVER commit real secrets or production credentials.

# Database - Amazon RDS PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@RDS_ENDPOINT:5432/concrecol_web?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@RDS_ENDPOINT:5432/concrecol_web?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="generate-a-secure-secret"
NEXTAUTH_URL="https://concrecol.co"

# Amazon Cognito
COGNITO_CLIENT_ID="your-cognito-client-id"
COGNITO_CLIENT_SECRET="your-cognito-client-secret"
COGNITO_ISSUER="https://cognito-idp.us-east-2.amazonaws.com/YOUR_USER_POOL_ID"

# Environment
NODE_ENV="production"

# Amazon SES SMTP
SMTP_HOST="email-smtp.us-east-2.amazonaws.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-ses-smtp-username"
SMTP_PASS="your-ses-smtp-password"
EMAIL_FROM="Concrecol <no-reply@concrecol.co>"
SALES_EMAIL="ventas@concrecol.co"

# Optional integrations
# STRIPE_PUBLIC_KEY=""
# STRIPE_SECRET_KEY=""
# SIIGO_USERNAME=""
# SIIGO_ACCESS_KEY=""
