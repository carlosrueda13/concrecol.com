# Configuración de la ruta base para GitHub Pages
NEXT_PUBLIC_BASE_PATH=/concrecol.com

# Base de datos (REQUERIDO)
DATABASE_URL="postgresql://username:password@host:port/database"

# Autenticación (REQUERIDO)
NEXTAUTH_SECRET="your-super-secret-key-minimum-32-characters-long"
NEXTAUTH_URL="https://carlosrueda13.github.io/concrecol.com"

# Admin por defecto (REQUERIDO)
ADMIN_DEFAULT_EMAIL="admin@concrecol.com"
ADMIN_DEFAULT_PASSWORD="your-secure-admin-password"

# Stripe (OPCIONAL - para pagos)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Redis (OPCIONAL - para rate limiting)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Email (OPCIONAL - para notificaciones)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""

# Siigo (OPCIONAL - para facturación)
SIIGO_BASE_URL=""
SIIGO_USERNAME=""
SIIGO_ACCESS_KEY=""